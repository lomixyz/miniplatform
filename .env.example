# Copy this file to .env (untracked by git) and fill in real values before
# running in production. Locally, the app falls back to safe dev defaults
# for all of these if they're not set.

# Random long string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Password for the two built-in privileged accounts ("admin" and
# "miniplatform") that always have Staff + Global Admin rights. Change this
# from the dev default before deploying anywhere public.
ADMIN_PASSWORD=

# Port the server listens on (defaults to 3000).
PORT=3000
